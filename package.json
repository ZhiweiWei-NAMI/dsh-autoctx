{
  "name": "dsh-autoctx",
  "version": "1.1.3",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "license": "MIT",
  "files": [
    "index.js",
    "client.js",
    "stats.js",
    "decisions.js",
    "routing.js",
    "graph.js",
    "models.js",
    "models.json",
    "cordis.patch.yml",
    "off.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction-basic": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-compaction": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "zod": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhiweiWei-NAMI/dsh-autoctx.git"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "description": "Jev-decided auto routing, subagents and context compaction for dsh, with a settings page and a composer statistics chip"
}
